{
  "installCommand": "npm install --prefix calendario-web/backend && npm install --prefix calendario-web/frontend",
  "buildCommand": "npm run build --prefix calendario-web/frontend",
  "outputDirectory": "calendario-web/frontend/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/event-reminders", "schedule": "0 11 * * *" },
    { "path": "/api/cron/midnight-tasks", "schedule": "5 3 * * *" }
  ]
}
